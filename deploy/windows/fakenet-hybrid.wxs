<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v4 source for the FakeNet hybrid MSI. Built in CI (see .github/workflows/release.yml)
     with `wix build`, after staging the payload (nucleus.exe + WinDivert, the daemon jar &
     lib & routes, default-files, the sample config, and the install/uninstall scripts) into
     a `stage\` folder. The MSI places the payload under "Program Files\FakeNet Hybrid"; the
     scheduled-task setup stays in install.ps1 (run once, elevated, from the Start Menu
     shortcut), so there's one source of truth for it. Lab use only. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="FakeNet Hybrid"
           Manufacturer="FakeNet Hybrid"
           Version="$(var.Version)"
           UpgradeCode="7D3E6B4C-2A91-4F2E-9C6D-5B1A0E8F3A27"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of FakeNet Hybrid is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Everything installs under Program Files\FakeNet Hybrid -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FakeNet Hybrid" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="FakeNet Hybrid" />
    </StandardDirectory>

    <Feature Id="Main" Title="FakeNet Hybrid" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <!-- Harvest the staged payload tree (WiX v4 auto-generates components) -->
    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="stage\**" />
    </ComponentGroup>

    <!-- A Start Menu shortcut to run the bundled setup (elevated), which registers the two
         scheduled tasks; and one to the install folder -->
    <Component Id="Shortcuts" Directory="AppShortcutFolder" Guid="2C9B5F10-7E34-4A8D-B1C2-6F0D9A4E5B38">
      <Shortcut Id="SetupShortcut"
                Name="Set up FakeNet Hybrid (run as admin)"
                Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                Arguments="-ExecutionPolicy Bypass -NoProfile -File &quot;[INSTALLFOLDER]register-tasks.ps1&quot;"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="FolderShortcut"
                Name="FakeNet Hybrid folder"
                Target="[INSTALLFOLDER]" />
      <RemoveFolder Id="RemoveAppShortcutFolder" Directory="AppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\FakeNetHybrid" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
